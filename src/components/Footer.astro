<footer class="site-footer">
  <p id="visit-stats" class="visit-stats"></p>
  <p>本个人博客于 2026.08.19 在 Cloudflare 构建 · 使用 Astro</p>
  <p class="footer-hidden">我说我想成为人类有没有懂的</p>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    padding: 2rem 0;
    text-align: center;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }

  .site-footer p {
    font-size: 0.8rem;
    color: rgba(0, 0, 0, 0.25);
    margin: 0.3rem 0;
    transition: color 0.5s ease;
  }

  .site-footer p:hover {
    color: rgba(0, 0, 0, 0.5);
  }

  .visit-stats {
    font-size: 0.75rem !important;
    letter-spacing: 0.02em;
  }

  .footer-hidden {
    font-size: 0.7rem !important;
    color: rgba(0, 0, 0, 0.08) !important;
    cursor: default;
    user-select: none;
    transition: color 0.8s ease;
  }

  .footer-hidden:hover {
    color: rgba(0, 0, 0, 0.35) !important;
  }
</style>

<script is:inline>
  fetch('/api/visit', { method: 'POST' })
    .then(function (r) { return r.json(); })
    .then(function (d) {
      document.getElementById('visit-stats').textContent =
        '👀 总访问 ' + d.pv + ' 次 · 今天 ' + d.today + ' 位朋友来过 · 累计 ' + d.uv + ' 位访客';
    })
    .catch(function () {
      document.getElementById('visit-stats').style.display = 'none';
    });
</script>
