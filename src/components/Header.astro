---
const navLinks = [
  { name: "首页", url: "/" },
  { name: "博客", url: "/blog" },
  { name: "关于", url: "/about" },
];
---

<header class="ios-header" id="nav-bar">
  <a href="/" class="logo">Mayu's Blog</a>
  <button class="menu-btn" aria-expanded="false" aria-controls="mobile-nav">
    <span aria-hidden="true">☰</span>
  </button>
  <ul id="mobile-nav" class="desktop-nav">
    {navLinks.map((link) => (
      <li><a href={link.url}>{link.name}</a></li>
    ))}
  </ul>
</header>

<style>
  .ios-header {
    position: fixed;
    top: 12px;
    left: 50%;
    transform: translateX(-50%) translateZ(0);
    -webkit-transform: translateX(-50%) translateZ(0);
    z-index: 1000;
    width: calc(100% - 24px);
    max-width: 780px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 1.2rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.25);
    -webkit-backdrop-filter: blur(8px) saturate(180%);
    backdrop-filter: blur(8px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.35);
    box-shadow: 0 2px 16px rgba(0, 0, 0, 0.06), inset 0 1px 0 rgba(255, 255, 255, 0.4);
    transition: background 0.3s ease;
  }

  .ios-header.scrolled {
    background: rgba(255, 255, 255, 0.38);
    -webkit-backdrop-filter: blur(9px) saturate(200%);
    backdrop-filter: blur(9px) saturate(200%);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.5);
  }

  .logo {
    font-weight: 700;
    font-size: 1.1rem;
    color: #1d1d1f;
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .desktop-nav {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 0.25rem;
  }

  .desktop-nav a {
    display: block;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    color: #1d1d1f;
    transition: background 0.2s ease;
  }

  .desktop-nav a:hover {
    background: rgba(255, 255, 255, 0.35);
  }

  .menu-btn {
    display: none;
    background: none;
    border: none;
    font-size: 1.4rem;
    cursor: pointer;
    padding: 0.3rem;
    color: #1d1d1f;
  }

  @media screen and (max-width: 636px) {
    .menu-btn {
      display: block;
    }

    .desktop-nav {
      display: none;
      position: absolute;
      top: calc(100% + 8px);
      left: 0;
      right: 0;
      flex-direction: column;
      background: rgba(255, 255, 255, 0.4);
      -webkit-backdrop-filter: blur(10px) saturate(180%);
      backdrop-filter: blur(10px) saturate(180%);
      border: 1px solid rgba(255, 255, 255, 0.35);
      border-radius: 20px;
      padding: 0.5rem;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
    }

    .desktop-nav a {
      padding: 0.7rem 1rem;
      border-radius: 14px;
    }

    :global(.menu-btn[aria-expanded="true"]) ~ .desktop-nav {
      display: flex;
    }
  }
</style>

<script is:inline>
  const btn = document.querySelector('.menu-btn');
  const nav = document.getElementById('mobile-nav');
  if (btn && nav) {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
    });
  }

  window.addEventListener('scroll', () => {
    const bar = document.getElementById('nav-bar');
    if (window.scrollY > 10) {
      bar.classList.add('scrolled');
    } else {
      bar.classList.remove('scrolled');
    }
  });
</script>
