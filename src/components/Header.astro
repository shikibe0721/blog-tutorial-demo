---
const navLinks = [
  { name: "首页", url: "/" },
  { name: "博客", url: "/blog" },
  { name: "关于", url: "/about" },
];
---

<header class="ios-header" id="nav-bar">
  <a href="/" class="logo">Mayu's Blog</a>
  <div class="right-side">
    <div class="user-area" id="user-area"></div>
    <button type="button" class="theme-btn" id="theme-toggle" title="切换深浅模式">🌙</button>
    <ul id="mobile-nav" class="desktop-nav">
      {navLinks.map((link) => (
        <li><a href={link.url}>{link.name}</a></li>
      ))}
    </ul>
    <button type="button" class="menu-btn" aria-expanded="false" aria-controls="mobile-nav">
      <span aria-hidden="true">☰</span>
    </button>
  </div>
</header>

<style>
  .ios-header {
    position: fixed;
    top: 12px;
    left: 50%;
    transform: translateX(-50%) translateZ(0);
    -webkit-transform: translateX(-50%) translateZ(0);
    z-index: 1000;
    width: calc(100% - 24px);
    max-width: 780px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 1.2rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.25);
    -webkit-backdrop-filter: blur(10px) saturate(180%);
    backdrop-filter: blur(10px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.35);
    box-shadow: 0 2px 16px rgba(0, 0, 0, 0.06), inset 0 1px 0 rgba(255, 255, 255, 0.4);
    transition: background 0.3s ease;
  }

  .ios-header.scrolled {
    background: rgba(255, 255, 255, 0.38);
    -webkit-backdrop-filter: blur(14px) saturate(200%);
    backdrop-filter: blur(14px) saturate(200%);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.5);
  }

  .right-side {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .theme-btn {
    background: rgba(255, 255, 255, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 999px;
    padding: 0.3rem 0.6rem;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .theme-btn:hover { background: rgba(255, 255, 255, 0.4); transform: scale(1.05); }

  .logo {
    font-weight: 700;
    font-size: 1.1rem;
    color: #1d1d1f;
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .desktop-nav {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 0.25rem;
  }

  .desktop-nav a {
    display: block;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    color: #1d1d1f;
    transition: background 0.2s ease;
  }

  .desktop-nav a:hover {
    background: rgba(255, 255, 255, 0.35);
  }

  .menu-btn {
    display: none;
    background: none;
    border: none;
    font-size: 1.4rem;
    cursor: pointer;
    padding: 0.3rem;
    color: #1d1d1f;
  }

  /* === 用户区域（JS 动态生成，必须用 :global） === */
  :global(.user-area) { display: flex; align-items: center; gap: 0.2rem; }
  :global(.user-chip) {
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.35);
    font-size: 0.85rem;
    font-weight: 500;
    color: #1d1d1f;
    max-width: 12ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  :global(.user-logout) {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 0.9rem;
    padding: 0.2rem 0.45rem;
    border-radius: 999px;
    color: #888;
    transition: all 0.2s;
  }
  :global(.user-logout:hover) { color: #ef4444; background: rgba(239, 68, 68, 0.1); }
  :global(.user-login) {
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    background: rgba(99, 102, 241, 0.12);
    border: 1px solid rgba(99, 102, 241, 0.2);
    color: #6366f1;
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s;
  }
  :global(.user-login:hover) { background: rgba(99, 102, 241, 0.2); }

  :global(html.dark .user-chip) {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.15);
    color: #e8e8f0;
  }
  :global(html.dark .user-login) {
    background: rgba(165, 166, 255, 0.12);
    border-color: rgba(165, 166, 255, 0.25);
    color: #a5a6ff;
  }
  :global(html.dark .user-logout) { color: #8888a0; }

  @media screen and (max-width: 636px) {
    .menu-btn {
      display: block;
    }

    .desktop-nav {
      display: none;
      position: absolute;
      top: calc(100% + 8px);
      left: 0;
      right: 0;
      flex-direction: column;
      background: rgba(255, 255, 255, 0.4);
      -webkit-backdrop-filter: blur(10px) saturate(180%);
      backdrop-filter: blur(10px) saturate(180%);
      border: 1px solid rgba(255, 255, 255, 0.35);
      border-radius: 20px;
      padding: 0.5rem;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
    }

    .desktop-nav a {
      padding: 0.7rem 1rem;
      border-radius: 14px;
    }

    :global(.menu-btn[aria-expanded="true"]) ~ .desktop-nav {
      display: flex;
    }
  }
</style>

<script is:inline>
  // === 用户区域渲染 ===
  function esc(s) {
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function renderUserArea() {
    const area = document.getElementById('user-area');
    const user = localStorage.getItem('mayu_user');
    const token = localStorage.getItem('mayu_token');
    if (user && token) {
      area.innerHTML = '<span class="user-chip" title="' + esc(user) + '">👤 ' + esc(user) + '</span><button type="button" class="user-logout" id="nav-logout" title="退出登录">⎋</button>';
      document.getElementById('nav-logout').addEventListener('click', async () => {
        await fetch('/api/logout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token }),
        }).catch(() => {});
        localStorage.removeItem('mayu_token');
        localStorage.removeItem('mayu_user');
        renderUserArea();
      });
    } else {
      area.innerHTML = '<a href="/user" class="user-login">登录</a>';
    }
  }
  renderUserArea();

  // === 深浅模式切换 ===
  const themeBtn = document.getElementById('theme-toggle');
  function updateThemeIcon() {
    const isDark = document.documentElement.classList.contains('dark');
    themeBtn.textContent = isDark ? '☀️' : '🌙';
  }
  themeBtn.addEventListener('click', () => {
    document.documentElement.classList.toggle('dark');
    const isDark = document.documentElement.classList.contains('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    updateThemeIcon();
  });
  updateThemeIcon();

  // === 汉堡菜单 ===
  const btn = document.querySelector('.menu-btn');
  const nav = document.getElementById('mobile-nav');
  if (btn && nav) {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
    });
  }

  // === 滚动加深磨砂 ===
  window.addEventListener('scroll', () => {
    const bar = document.getElementById('nav-bar');
    if (window.scrollY > 10) {
      bar.classList.add('scrolled');
    } else {
      bar.classList.remove('scrolled');
    }
  });
</script>
