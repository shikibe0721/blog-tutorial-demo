---
import BaseLayout from "../layouts/BaseLayout.astro";
const pageTitle = "我的技术博客";
---

<BaseLayout pageTitle={pageTitle}>
  <p>记录我的点点滴滴。</p>
  <p><a href="/admin">👉 进入管理后台</a></p>

  <div id="blog-list"><p style="color:#888;">加载中...</p></div>
</BaseLayout>

<script is:inline>
  async function loadBlogPosts() {
    try {
      const res = await fetch('/api/posts');
      const posts = await res.json();
      const container = document.getElementById('blog-list');

      if (posts.length === 0) {
        container.innerHTML = '<p style="color:#888;">暂无文章，去 <a href="/admin">后台</a> 写一篇吧！</p>';
        return;
      }

      container.innerHTML = '<ul style="list-style:none;padding:0;">' + posts.map(post => {
        const tags = JSON.parse(post.tags || '[]');
        const tagHtml = tags.map(tag =>
          `<span style="display:inline-block;margin-right:0.5rem;padding:0.15rem 0.6rem;background:#eef2ff;color:#6366f1;border-radius:999px;font-size:0.85rem;">${tag}</span>`
        ).join('');

        return `
          <li style="margin-bottom:1.5rem;padding:1rem;border:1px solid #eee;border-radius:8px;">
            <h2 style="margin:0 0 0.5rem 0;font-size:1.3rem;">${post.title}</h2>
            <p style="color:#888;font-size:0.9rem;margin:0 0 0.5rem 0;">
              📅 ${post.pub_date} · ✍️ ${post.author}
            </p>
            ${post.description ? `<p style="color:#555;margin:0;">${post.description}</p>` : ''}
            ${tags.length > 0 ? `<div style="margin-top:0.5rem;">${tagHtml}</div>` : ''}
          </li>
        `;
      }).join('') + '</ul>';
    } catch (e) {
      document.getElementById('blog-list').innerHTML = '<p style="color:red;">加载失败，请刷新重试</p>';
    }
  }

  loadBlogPosts();
</script>
