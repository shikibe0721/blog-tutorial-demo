---
import BaseLayout from "../layouts/BaseLayout.astro";
const pageTitle = "归档";
---

<BaseLayout pageTitle={pageTitle}>
  <div class="arch-stats" id="arch-stats" data-aos="fade-up"></div>
  <div class="arch-tags" id="arch-tags" data-aos="fade-up"></div>
  <div id="timeline-wrap"><p style="color:#888;">加载中...</p></div>
</BaseLayout>

<style>
  /* === 数据卡 === */
  :global(.arch-stats) {
    display: flex;
    gap: 2.5rem;
    flex-wrap: wrap;
    margin: 0.5rem 0 2rem;
  }
  :global(.arch-stat b) {
    display: block;
    font-size: 1.8rem;
    font-weight: 700;
    color: #1d1d1f;
    letter-spacing: -0.02em;
  }
  :global(.arch-stat span) {
    font-size: 0.8rem;
    color: #888;
  }
  :global(html.dark .arch-stat b) { color: #f2f2fa; }
  :global(html.dark .arch-stat span) { color: #8888a0; }

  /* === 标签云 === */
  :global(.arch-tags) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    align-items: baseline;
    margin: 0 0 1.5rem;
  }
  :global(.arch-tag) {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: #6366f1;
    font-weight: 500;
    transition: all 0.3s ease;
  }
  :global(.arch-tag:hover) { transform: scale(1.12); opacity: 0.8; }
  :global(.arch-tag.active) {
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 2px;
  }
  :global(html.dark .arch-tag) { color: #a5a6ff; }
  :global(.arch-clear) {
    background: none;
    border: 1px solid rgba(128, 128, 128, 0.3);
    border-radius: 999px;
    padding: 0.15rem 0.7rem;
    font-size: 0.75rem;
    color: #888;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  :global(.arch-clear:hover) { background: rgba(128, 128, 128, 0.1); }

  /* === 巨大描边年份 === */
  :global(.tl-year) {
    font-size: clamp(6rem, 18vw, 11rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    color: rgba(0, 0, 0, 0.08);
    margin: 3.5rem 0 -1.5rem;
    user-select: none;
    pointer-events: none;
  }
  :global(.tl-year:first-child) { margin-top: 1rem; }
  @supports (-webkit-text-stroke: 1px black) {
    :global(.tl-year) {
      color: transparent;
      -webkit-text-stroke: 2px rgba(0, 0, 0, 0.15);
    }
    :global(html.dark .tl-year) {
      -webkit-text-stroke: 2px rgba(255, 255, 255, 0.12);
    }
  }
  :global(html.dark .tl-year) { color: rgba(255, 255, 255, 0.06); }

  /* === 极简列表 === */
  :global(.tl-list) {
    list-style: none;
    padding: 0;
    margin: 0;
    position: relative;
  }

  :global(.tl-item) {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 1.2rem 0;
    text-decoration: none;
    /* 丝滑的位移缓动曲线 */
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1); 
  }
  :global(.tl-item:hover) { transform: translateX(8px); }

  :global(.tl-title) {
    font-size: 1.35rem;
    font-weight: 600;
    color: #333;
    /* 核心修复 1：标题颜色过渡 */
    transition: color 0.3s ease; 
  }
  :global(html.dark .tl-title) { color: #d8d8e4; }
  :global(.tl-item:hover .tl-title) { color: #6366f1; }
  :global(html.dark .tl-item:hover .tl-title) { color: #a5a6ff; }

  :global(.tl-meta) {
    font-size: 0.95rem;
    color: #999;
    white-space: nowrap;
    /* 核心修复 2：小字加上颜色与透明度过渡！ */
    transition: color 0.3s ease, opacity 0.3s ease; 
  }
  :global(html.dark .tl-meta) { color: #77778c; }
  
  /* 核心修复 3：悬停时小字跟着一起优雅变蓝 */
  :global(.tl-item:hover .tl-meta) { 
    color: #818cf8; 
    opacity: 0.9;
  }
  :global(html.dark .tl-item:hover .tl-meta) { 
    color: #c4b5fd; 
    opacity: 0.9;
  }

  :global(.tl-empty) { color: #888; }
</style>

<script is:inline>
  var MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  var allPosts = [];
  var activeTag = null;

  function esc(s) {
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function fmtDate(d) {
    var parts = (d || '').slice(0, 10).split('-');
    if (parts.length < 3) return d || '';
    return MONTHS[parseInt(parts[1], 10) - 1] + ' ' + parseInt(parts[2], 10);
  }

  function readMin(c) {
    return Math.max(1, Math.round((c || '').length / 400));
  }

  function tagCounts() {
    var counts = {};
    allPosts.forEach(function (p) {
      JSON.parse(p.tags || '[]').forEach(function (t) { counts[t] = (counts[t] || 0) + 1; });
    });
    return counts;
  }

  function renderStats() {
    var counts = tagCounts();
    var chars = allPosts.reduce(function (s, p) { return s + (p.content || '').length; }, 0);
    var dates = allPosts.map(function (p) { return p.pub_date; }).filter(Boolean).sort();
    var days = 1;
    if (dates.length > 0) {
      days = Math.max(1, Math.floor((Date.now() - new Date(dates[0] + 'T00:00:00').getTime()) / 86400000));
    }
    document.getElementById('arch-stats').innerHTML =
      '<div class="arch-stat"><b>' + allPosts.length + '</b><span>篇文章</span></div>' +
      '<div class="arch-stat"><b>' + (chars / 1000).toFixed(1) + 'k</b><span>总字数</span></div>' +
      '<div class="arch-stat"><b>' + days + '</b><span>天写作</span></div>' +
      '<div class="arch-stat"><b>' + Object.keys(counts).length + '</b><span>个标签</span></div>';
  }

  function renderTagCloud() {
    var counts = tagCounts();
    var tags = Object.keys(counts).sort(function (a, b) { return counts[b] - counts[a]; });
    var el = document.getElementById('arch-tags');
    if (tags.length === 0) { el.innerHTML = ''; return; }
    var html = tags.map(function (t) {
      var size = (0.85 + Math.min(counts[t], 6) * 0.09).toFixed(2);
      return '<button type="button" class="arch-tag' + (activeTag === t ? ' active' : '') + '" data-tag="' + esc(t) + '" style="font-size:' + size + 'rem;" title="' + counts[t] + ' 篇">' + esc(t) + '</button>';
    }).join('');
    if (activeTag) html += '<button type="button" class="arch-clear" id="arch-clear">✕ 清除筛选</button>';
    el.innerHTML = html;
    el.querySelectorAll('.arch-tag').forEach(function (b) {
      b.addEventListener('click', function () {
        activeTag = activeTag === b.dataset.tag ? null : b.dataset.tag;
        renderTagCloud();
        renderTimeline();
      });
    });
    var clearBtn = document.getElementById('arch-clear');
    if (clearBtn) clearBtn.addEventListener('click', function () {
      activeTag = null;
      renderTagCloud();
      renderTimeline();
    });
  }

  function renderTimeline() {
    var posts = allPosts.slice();
    if (activeTag) posts = posts.filter(function (p) { return JSON.parse(p.tags || '[]').indexOf(activeTag) !== -1; });
    posts.sort(function (a, b) { return a.pub_date < b.pub_date ? 1 : -1; });

    if (posts.length === 0) {
      document.getElementById('timeline-wrap').innerHTML = '<p class="tl-empty">这个标签下还没有文章~</p>';
      return;
    }

    var groups = {};
    posts.forEach(function (p) {
      var y = (p.pub_date || '').slice(0, 4) || '????';
      (groups[y] = groups[y] || []).push(p);
    });

    var years = Object.keys(groups).sort(function (a, b) { return a < b ? 1 : -1; });
    var html = '';
    years.forEach(function (year) {
      html += '<div class="tl-year">' + year + '</div><ul class="tl-list">';
      groups[year].forEach(function (p) {
        html += '<li><a class="tl-item" href="/posts/' + p.slug + '">' +
          '<span class="tl-title">' + esc(p.title) + '</span>' +
          '<span class="tl-meta">' + fmtDate(p.pub_date) + ' · ' + readMin(p.content) + 'min</span>' +
          '</a></li>';
      });
      html += '</ul>';
    });
    document.getElementById('timeline-wrap').innerHTML = html;
  }

  async function loadAll() {
    try {
      var res = await fetch('/api/posts');
      allPosts = await res.json();
      renderStats();
      renderTagCloud();
      renderTimeline();
    } catch (e) {
      document.getElementById('timeline-wrap').innerHTML = '<p style="color:red;">加载失败</p>';
    }
  }
  loadAll();
</script>
