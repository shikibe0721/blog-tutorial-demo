---
import BaseLayout from "../../layouts/BaseLayout.astro";
export const prerender = true;
const pageTitle = "博客管理后台";
---

<BaseLayout pageTitle={pageTitle}>
  <div class="admin-container" data-liquid-glass>
    <h1 style="margin:0 0 1.5rem;font-size:1.8rem;">📝 博客管理后台</h1>

    <!-- 登录面板 -->
    <div id="login-panel">
      <div class="login-box">
        <p class="login-hint">请输入管理密码以继续</p>
        <div class="input-group">
          <input type="password" id="password" placeholder="输入管理密码" autocomplete="off" />
          <button onclick="login()" class="ios-btn">登录</button>
        </div>
        <p id="login-error" class="login-error"></p>
      </div>
    </div>

    <!-- 编辑面板（默认隐藏） -->
    <div id="editor-panel" style="display:none;">
      <div class="toolbar">
        <button onclick="loadPosts()" class="ios-btn-secondary">🔄 刷新列表</button>
        <button onclick="showNewForm()" class="ios-btn">➕ 新文章</button>
        <button onclick="logout()" class="ios-btn-danger" style="margin-left:auto;">退出</button>
      </div>

      <div id="post-list"></div>

      <div id="post-form" class="post-form-hidden">
        <h3 id="form-title" class="form-title">新建文章</h3>
        <input type="hidden" id="edit-id" />

        <div class="form-field">
          <label>标题</label>
          <input type="text" id="f-title" placeholder="文章标题" />
        </div>

        <div class="form-field">
          <label>Slug（URL路径，英文短横线分隔）</label>
          <input type="text" id="f-slug" placeholder="my-first-post" />
        </div>

        <div class="form-field">
          <label>描述</label>
          <textarea id="f-desc" rows="1" maxlength="127" placeholder="一句话简介（最多 127 字）"></textarea>
          <div class="counter" id="desc-count">0/127</div>
        </div>

        <div class="form-field">
          <label>标签（逗号分隔）</label>
          <input type="text" id="f-tags" placeholder="astro, 学习, 前端" />
        </div>

        <div class="form-field">
          <label>发布日期</label>
          <div class="date-wrap">
            <input type="text" id="f-date" placeholder="YYYY-MM-DD" readonly />
            <button type="button" class="date-btn" id="date-toggle">📅</button>
            <div class="calendar" id="calendar" style="display:none;">
              <div class="cal-head">
                <button type="button" class="cal-nav" id="cal-prev">‹</button>
                <span id="cal-title"></span>
                <button type="button" class="cal-nav" id="cal-next">›</button>
              </div>
              <div class="cal-week">
                <span>日</span><span>一</span><span>二</span><span>三</span><span>四</span><span>五</span><span>六</span>
              </div>
              <div class="cal-days" id="cal-days"></div>
            </div>
          </div>
        </div>

        <div class="form-field">
          <label>正文（支持简单 Markdown，最多 1023 字）</label>
          <textarea id="f-content" rows="5" maxlength="1023" placeholder="在这里写文章内容..."></textarea>
          <div class="counter" id="content-count">0/1023</div>
        </div>

        <div style="display:flex;gap:0.5rem;margin-top:0.5rem;">
          <button onclick="savePost()" class="ios-btn">💾 保存</button>
          <button onclick="hideForm()" class="ios-btn-secondary">取消</button>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* === 1. 外层容器：去掉了 backdrop-filter，防止“套娃磨砂”导致内层失效 === */
  .admin-container {
    max-width: 700px;
    margin: 2rem auto;
    padding: 2rem;
    background: rgba(255, 255, 255, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 20px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06), inset 0 1px 0 rgba(255, 255, 255, 0.5);
  }

  h1 { color: #1d1d1f; }

  .login-box { text-align: center; padding: 2rem 0; }
  .login-hint { color: #666; margin-bottom: 1rem; font-size: 0.95rem; }
  .login-error { color: #ef4444; font-size: 0.85rem; margin-top: 0.5rem; display: none; min-height: 1.2em; }
  .input-group { display: flex; gap: 0.5rem; justify-content: center; }
  .input-group input { flex: 1; max-width: 280px; }
  .toolbar { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem; flex-wrap: wrap; }
  
  /* === 2. 表单面板：去掉了 backdrop-filter === */
  .post-form-hidden {
    display: none;
    margin-top: 1rem;
    padding: 1.5rem;
    background: rgba(255,255,255,0.3);
    border: 1px solid rgba(255,255,255,0.4);
    border-radius: 16px;
  }
  .form-title { margin: 0 0 1rem; color: #1d1d1f; }

  .form-field { margin-bottom: 1rem; }
  .form-field label { display: block; font-size: 0.85rem; color: #555; margin-bottom: 0.3rem; font-weight: 500; }

  input, textarea {
    width: 100%;
    padding: 0.6rem 0.9rem;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.5);
    backdrop-filter: blur(8px);
    font-size: 0.95rem;
    color: #1d1d1f;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
    box-sizing: border-box;
  }
  input:focus, textarea:focus {
    border-color: rgba(99, 102, 241, 0.5);
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
  }
  textarea {
    font-family: "SF Mono", "Fira Code", monospace;
    resize: vertical;
    overflow-y: auto;
    line-height: 1.6;
  }

  .counter { text-align: right; font-size: 0.75rem; color: #999; margin-top: 0.2rem; }

  /* === 自定义玻璃日历 === */
  .date-wrap { position: relative; display: flex; gap: 0.5rem; }
  .date-wrap input { flex: 1; }
  .date-btn {
    background: rgba(99, 102, 241, 0.12);
    border: 1px solid rgba(99, 102, 241, 0.2);
    border-radius: 12px;
    padding: 0.4rem 0.8rem;
    cursor: pointer;
    font-size: 1rem;
    transition: all 0.2s;
  }
  .date-btn:hover { background: rgba(99, 102, 241, 0.2); }

  .calendar {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    z-index: 50;
    width: 280px;
    padding: 0.8rem;
    background: rgba(255, 255, 255, 0.65); /* 半透 */
    backdrop-filter: blur(20px) saturate(180%); /* 磨砂生效区 */
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 16px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
  }
  .cal-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; font-weight: 600; color: #1d1d1f; }
  .cal-nav { background: none; border: none; cursor: pointer; font-size: 1.1rem; padding: 0.2rem 0.6rem; border-radius: 8px; color: #6366f1; }
  .cal-nav:hover { background: rgba(99, 102, 241, 0.1); }
  .cal-week { display: grid; grid-template-columns: repeat(7, 1fr); text-align: center; font-size: 0.75rem; color: #888; margin-bottom: 0.3rem; }
  .cal-days { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; }

  /* === 3. 日历日期格子（JS 动态生成，必须加 :global ！！） === */
  :global(.cal-day) { background: none; border: none; cursor: pointer; padding: 0.35rem 0; border-radius: 8px; font-size: 0.85rem; color: #333; transition: background 0.15s; }
  :global(.cal-day:hover) { background: rgba(99, 102, 241, 0.12); }
  :global(.cal-day.today) { border: 1px solid rgba(99, 102, 241, 0.4); }
  :global(.cal-day.selected) { background: #6366f1; color: #fff; }
  :global(.cal-empty) { visibility: hidden; }

  /* iOS 风格按钮 */
  .ios-btn {
    display: inline-block;
    padding: 0.5rem 1.2rem;
    background: rgba(99, 102, 241, 0.12);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(99, 102, 241, 0.2);
    border-radius: 999px;
    color: #6366f1;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .ios-btn:hover { background: rgba(99, 102, 241, 0.2); transform: scale(1.03); }
  .ios-btn:active { transform: scale(0.97); }

  .ios-btn-secondary {
    display: inline-block;
    padding: 0.5rem 1.2rem;
    background: rgba(0, 0, 0, 0.05);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 999px;
    color: #555;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .ios-btn-secondary:hover { background: rgba(0, 0, 0, 0.1); }

  .ios-btn-danger {
    display: inline-block;
    padding: 0.5rem 1.2rem;
    background: rgba(239, 68, 68, 0.1);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(239, 68, 68, 0.2);
    border-radius: 999px;
    color: #ef4444;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .ios-btn-danger:hover { background: rgba(239, 68, 68, 0.2); }

  :global(.post-item) {
    padding: 1rem 1.2rem;
    margin-bottom: 0.6rem;
    background: rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: background 0.2s;
  }
  :global(.post-item:hover) { background: rgba(255, 255, 255, 0.5); }
  :global(.post-item-info) { flex: 1; }
  :global(.post-item-title) { font-weight: 600; color: #1d1d1f; font-size: 1rem; }
  :global(.post-item-date) { color: #888; font-size: 0.8rem; margin-top: 0.2rem; }
  :global(.post-item-actions) { display: flex; gap: 0.3rem; }
  :global(.post-item-actions button) { padding: 0.3rem 0.8rem !important; font-size: 0.8rem !important; }

  /* ========== 深色模式完美适配 ========== */
  html.dark .admin-container {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.12);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }
  html.dark h1 { color: #f2f2fa; }
  html.dark .login-hint { color: #b8b8cc; }
  
  html.dark .post-form-hidden {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }
  html.dark .form-title { color: #f2f2fa; }
  html.dark .form-field label { color: #b8b8cc; }
  
  html.dark .admin-container input,
  html.dark .admin-container textarea {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.15);
    color: #e8e8f0;
  }
  html.dark .admin-container input::placeholder,
  html.dark .admin-container textarea::placeholder { color: #8888a0; }
  html.dark .counter { color: #8888a0; }
  
  html.dark .calendar { background: rgba(30, 30, 52, 0.65); border-color: rgba(255, 255, 255, 0.15); backdrop-filter: blur(20px) saturate(180%); -webkit-backdrop-filter: blur(20px) saturate(180%); }
  html.dark .cal-head { color: #f2f2fa; }
  html.dark .cal-week { color: #8888a0; }
  
  :global(html.dark .cal-day) { color: #d0d0e0; }
  :global(html.dark .cal-day:hover) { background: rgba(165, 166, 255, 0.15); }
  :global(html.dark .cal-day.today) { border-color: rgba(165, 166, 255, 0.5); }
  :global(html.dark .cal-day.selected) { background: #6366f1; color: #fff; }
  
  html.dark .date-btn {
    background: rgba(165, 166, 255, 0.12);
    border-color: rgba(165, 166, 255, 0.25);
  }

  html.dark :global(.post-item) {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.12);
  }
  html.dark :global(.post-item-title) { color: #f2f2fa; }
  html.dark :global(.post-item-date) { color: #8888a0; }
</style>

<script is:inline>
  // === 登录 ===
  function login() {
    const pw = document.getElementById('password').value;
    if (!pw) { showError('请输入密码'); return; }

    fetch('/api/auth', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ password: pw })
    }).then(res => res.json().then(data => ({ ok: res.ok, data }))).then(({ ok, data }) => {
      if (ok) {
        document.getElementById('login-panel').style.display = 'none';
        document.getElementById('editor-panel').style.display = 'block';
        loadPosts();
      } else {
        showError(data.error || '密码错误');
      }
    }).catch(() => showError('网络错误，请重试'));
  }

  function showError(msg) {
    const el = document.getElementById('login-error');
    el.textContent = msg;
    el.style.display = 'block';
    setTimeout(() => { el.style.display = 'none'; }, 5000);
  }

  function logout() {
    document.getElementById('editor-panel').style.display = 'none';
    document.getElementById('login-panel').style.display = 'block';
    document.getElementById('password').value = '';
  }

  document.getElementById('password').addEventListener('keydown', (e) => {
    if (e.key === 'Enter') login();
  });

  // === 文本框自动长高 + 字数统计 ===
  const descEl = document.getElementById('f-desc');
  const contentEl = document.getElementById('f-content');

  function autoGrow(el) {
    if (!el.offsetParent) return; 
    el.style.height = 'auto';
    el.style.height = Math.min(el.scrollHeight + 2, 420) + 'px';
  }

  function refreshCounters() {
    document.getElementById('desc-count').textContent = descEl.value.length + '/127';
    document.getElementById('content-count').textContent = contentEl.value.length + '/1023';
  }

  descEl.addEventListener('input', () => { autoGrow(descEl); refreshCounters(); });
  contentEl.addEventListener('input', () => { autoGrow(contentEl); refreshCounters(); });

  // === 自定义玻璃日历 ===
  const calEl = document.getElementById('calendar');
  let calYear, calMonth;

  function fmtDate(d) {
    return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
  }

  function renderCalendar() {
    document.getElementById('cal-title').textContent = calYear + ' 年 ' + (calMonth + 1) + ' 月';
    const firstDay = new Date(calYear, calMonth, 1).getDay();
    const daysInMonth = new Date(calYear, calMonth + 1, 0).getDate();
    const selected = document.getElementById('f-date').value;
    const todayStr = fmtDate(new Date());

    let html = '';
    for (let i = 0; i < firstDay; i++) html += '<span class="cal-empty"></span>';
    for (let d = 1; d <= daysInMonth; d++) {
      const dateStr = calYear + '-' + String(calMonth + 1).padStart(2, '0') + '-' + String(d).padStart(2, '0');
      const cls = ['cal-day'];
      if (dateStr === selected) cls.push('selected');
      if (dateStr === todayStr) cls.push('today');
      html += '<button type="button" class="' + cls.join(' ') + '" data-date="' + dateStr + '">' + d + '</button>';
    }
    const daysEl = document.getElementById('cal-days');
    daysEl.innerHTML = html;
    daysEl.querySelectorAll('.cal-day').forEach(btn => {
      btn.addEventListener('click', () => {
        document.getElementById('f-date').value = btn.dataset.date;
        calEl.style.display = 'none';
      });
    });
  }

  document.getElementById('date-toggle').addEventListener('click', () => {
    if (calEl.style.display === 'none') {
      const val = document.getElementById('f-date').value;
      const base = val ? new Date(val + 'T00:00:00') : new Date();
      calYear = base.getFullYear();
      calMonth = base.getMonth();
      renderCalendar();
      calEl.style.display = 'block';
    } else {
      calEl.style.display = 'none';
    }
  });
  document.getElementById('cal-prev').addEventListener('click', () => { calMonth--; if (calMonth < 0) { calMonth = 11; calYear--; } renderCalendar(); });
  document.getElementById('cal-next').addEventListener('click', () => { calMonth++; if (calMonth > 11) { calMonth = 0; calYear++; } renderCalendar(); });

  // === 文章列表 ===
  async function loadPosts() {
    const res = await fetch('/api/posts');
    const posts = await res.json();
    const list = document.getElementById('post-list');
    if (posts.length === 0) {
      list.innerHTML = '<p style="color:#888;text-align:center;padding:2rem 0;">暂无文章，点击"新文章"开始写作吧！</p>';
      return;
    }
    list.innerHTML = posts.map(p => {
      const safePost = JSON.stringify(p).replace(/'/g, "&#39;").replace(/"/g, '&quot;');
      return '<div class="post-item"><div class="post-item-info"><div class="post-item-title">' + p.title + '</div><div class="post-item-date">📅 ' + p.pub_date + '</div></div><div class="post-item-actions"><button onclick=\'editPost(' + safePost + ')\' class="ios-btn-secondary">编辑</button><button onclick="deletePost(' + p.id + ')" class="ios-btn-danger">删除</button></div></div>';
    }).join('');
  }

  // === 表单操作 ===
  function showNewForm() {
    document.getElementById('form-title').textContent = '新建文章';
    document.getElementById('edit-id').value = '';
    document.getElementById('f-title').value = '';
    document.getElementById('f-slug').value = '';
    descEl.value = '';
    document.getElementById('f-tags').value = '';
    document.getElementById('f-date').value = fmtDate(new Date());
    contentEl.value = '';
    
    document.getElementById('post-form').style.display = 'block';
    autoGrow(descEl); 
    autoGrow(contentEl); 
    refreshCounters();
  }

  function editPost(post) {
    document.getElementById('form-title').textContent = '编辑文章';
    document.getElementById('edit-id').value = post.id;
    document.getElementById('f-title').value = post.title;
    document.getElementById('f-slug').value = post.slug;
    descEl.value = post.description || '';
    document.getElementById('f-tags').value = JSON.parse(post.tags || '[]').join(', ');
    document.getElementById('f-date').value = post.pub_date ? post.pub_date.slice(0, 10) : '';
    contentEl.value = post.content || '';
    
    document.getElementById('post-form').style.display = 'block';
    autoGrow(descEl); 
    autoGrow(contentEl); 
    refreshCounters();
  }

  function hideForm() {
    document.getElementById('post-form').style.display = 'none';
  }

  async function savePost() {
    const id = document.getElementById('edit-id').value;
    const data = {
      title: document.getElementById('f-title').value,
      slug: document.getElementById('f-slug').value,
      description: descEl.value,
      tags: document.getElementById('f-tags').value.split(',').map(t => t.trim()).filter(Boolean),
      pub_date: document.getElementById('f-date').value,
      content: contentEl.value,
    };

    if (!data.title || !data.slug) { alert('标题和Slug不能为空'); return; }

    const url = id ? '/api/posts/' + id : '/api/posts';
    const method = id ? 'PUT' : 'POST';

    const res = await fetch(url, {
      method,
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });

    if (res.ok) {
      alert('保存成功！');
      hideForm();
      loadPosts();
    } else {
      alert('保存失败，请检查控制台');
    }
  }

  async function deletePost(id) {
    if (!confirm('确定要删除这篇文章吗？此操作不可撤销。')) return;
    await fetch('/api/posts/' + id, { method: 'DELETE' });
    loadPosts();
  }
</script>
